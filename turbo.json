{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".nvmrc", "tsconfig.base.json", "biome.json", ".gitignore"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "env": [
        "NEXT_PUBLIC_SENTRY_DSN",
        "RAILWAY_ENVIRONMENT_NAME",
        "RAILWAY_GIT_COMMIT_SHA",
        "SENTRY_AUTH_TOKEN"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build", "//#lint:root"]
    },
    "test": {
      "dependsOn": ["^build", "//#test:root"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL", "DATABASE_URL"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "CI",
        "E2E_PORT",
        "PLAYWRIGHT_BROWSERS_PATH",
        "TEST_DATABASE_URL",
        "DATABASE_URL"
      ]
    },
    "check": {
      "dependsOn": ["^build", "//#check:root"]
    },
    "format:check": {
      "dependsOn": ["//#format:check:root"]
    },
    "//#format:check:root": {},
    "//#lint:root": {
      "inputs": [".claude/**", "scripts/**", ".githooks/**", ".shellcheckrc"]
    },
    "//#test:root": {
      "inputs": [
        ".claude/**",
        ".agents/agents/**",
        ".github/agents/**",
        ".codex/**",
        "scripts/**",
        ".githooks/**",
        "Dockerfile",
        "apps/web/package.json",
        ".github/rulesets/**",
        ".github/repo-settings.json",
        ".github/workflows/ci.yml",
        "e2e/maestro/*.yaml",
        "e2e/maestro/*.yml",
        "apps/ios/**/project.pbxproj",
        "apps/ios/FivviPro/Assets.xcassets/**",
        "apps/ios/README.md",
        "apps/android/README.md",
        "apps/android/app/src/main/res/**",
        "apps/android/app/src/main/ic_launcher-playstore.png",
        "apps/Version.xcconfig",
        "packages/design-tokens/src/**",
        "packages/design-tokens/tokens/**",
        "packages/design-tokens/generated/web/tokens.css",
        "packages/design-tokens/package.json",
        "apps/android/app/src/main/AndroidManifest.xml",
        "packages/*/*/Package.swift"
      ]
    },
    "//#check:root": {
      "inputs": [
        ".agents/**",
        ".claude/agents/**",
        ".github/agents/**",
        ".codex/**",
        "scripts/skills.sh",
        "scripts/agents.sh",
        "scripts/_lib.sh"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
