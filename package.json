{
  "name": "fivvi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=26.8.0 <27"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.8.0 <27",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:ios": "scripts/test-ios.sh",
    "test:android": "scripts/android.sh test",
    "test:maestro": "scripts/maestro.sh android",
    "app-icon": "node scripts/app-icon.mjs",
    "format:check": "turbo run format:check",
    "check": "turbo run check",
    "generate:contract": "pnpm --filter @fivvi/contract generate",
    "format:check:root": "biome format ./*.json .claude scripts",
    "lint:root": "biome lint .claude scripts && shellcheck -x scripts/*.sh .githooks/*",
    "check:root": "scripts/skills.sh check && scripts/agents.sh check",
    "test:root": "node --test '.claude/hooks/*.test.mjs' 'scripts/test/*.test.mjs'",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "db:up": "docker compose up --detach --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @fivvi/database db:generate",
    "db:migrate": "pnpm --filter @fivvi/database db:migrate",
    "db:seed": "pnpm --filter @fivvi/database db:seed",
    "email:preview": "pnpm --filter @fivvi/email preview",
    "email:send-test": "pnpm --filter @fivvi/email send:test"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@fivvi/design-tokens": "workspace:*",
    "railway": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
