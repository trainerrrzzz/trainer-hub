{
  "sourceLanguage" : "nl",
  "strings" : {
    "app.name" : {
      "comment" : "Name of the native app under its home-screen icon (iOS CFBundleDisplayName and CFBundleName, Android app label). The name of the trainer app, Fivvi Pro, the same in both languages.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fivvi Pro"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fivvi Pro"
          }
        }
      }
    },
    "app.title" : {
      "comment" : "Browser tab title (HTML <title>) of web pages that don't set their own. The product name, Fivvi, the same in both languages.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fivvi"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fivvi"
          }
        }
      }
    },
    "common.loading" : {
      "comment" : "Accessibility label of the progress indicator while a screen loads (read by VoiceOver and TalkBack).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loading…"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laden…"
          }
        }
      }
    },
    "common.retry" : {
      "comment" : "Button under an error message that tries the failed action again.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try again"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opnieuw proberen"
          }
        }
      }
    },
    "hello.continue" : {
      "comment" : "Submit button of the first-name form on the hello page. Shows hello.formGreeting with the name entered.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doorgaan"
          }
        }
      }
    },
    "hello.description" : {
      "comment" : "Line under the title of the hello page, above the first-name field.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your first name and we'll greet you."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vul je voornaam in, dan begroeten we je."
          }
        }
      }
    },
    "hello.error" : {
      "comment" : "Shown on the native hello screen when the greeting can't be loaded (no connection, or an unknown greeting). Above the common.retry button.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't load the greeting. Try again."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We konden de begroeting niet laden. Probeer het opnieuw."
          }
        }
      }
    },
    "hello.firstNameLabel" : {
      "comment" : "Label of the first-name field on the hello page.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First name"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voornaam"
          }
        }
      }
    },
    "hello.formGreeting" : {
      "comment" : "Shown on the hello page after the first-name form is sent. {name} is the first name entered.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi %1$@, nice to have you here."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoi %1$@, fijn dat je er bent."
          }
        }
      }
    },
    "hello.greeting" : {
      "comment" : "Greeting above the home screen. {name} is the user's first name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi %1$@,"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoi %1$@,"
          }
        }
      }
    },
    "hello.nextSession" : {
      "comment" : "{date} is a weekday and date without year, e.g. 'dinsdag 22 september'. {time} is a 24-hour time, e.g. '18:00'. Both are formatted in code in the workspace time zone.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your next session is on %1$@ at %2$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je volgende sessie is op %1$@ om %2$@."
          }
        }
      }
    },
    "hello.noSessionsToday" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have no sessions today."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt vandaag geen sessies."
          }
        }
      }
    },
    "hello.sessionsToday" : {
      "comment" : "Number of sessions the trainer has today, 1 or more. For 0, use hello.noSessionsToday.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "You have %arg session today."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "You have %arg sessions today."
                    }
                  }
                }
              }
            }
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Je hebt vandaag %arg sessie."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Je hebt vandaag %arg sessies."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "hello.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to Fivvi"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welkom bij Fivvi"
          }
        }
      }
    },
    "home.description" : {
      "comment" : "Line under the heading of the placeholder signed-in home.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your workspace will appear here soon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier komt straks je werkruimte."
          }
        }
      }
    },
    "home.title" : {
      "comment" : "Heading of the signed-in home, a placeholder until workspaces arrive (F002).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're signed in"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent ingelogd"
          }
        }
      }
    },
    "notFound.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We can't find this page. Check the link and try again."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We kunnen deze pagina niet vinden. Controleer de link en probeer het opnieuw."
          }
        }
      }
    },
    "notFound.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Page not found"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagina niet gevonden"
          }
        }
      }
    },
    "signIn.changeEmail" : {
      "comment" : "Button on the second step that goes back to the email field.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change email address"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-mailadres wijzigen"
          }
        }
      }
    },
    "signIn.checkEmailBody" : {
      "comment" : "Under the heading of the second step. {email} is the address that was entered. Deliberately does not say whether an account exists (no account enumeration).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If %1$@ is registered, you'll receive an email with a code and a sign-in link."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als %1$@ bij ons bekend is, ontvang je een e-mail met een code en een inloglink."
          }
        }
      }
    },
    "signIn.checkEmailTitle" : {
      "comment" : "Heading of the second step of the sign-in page, shown after the email address was sent. Same wording whether or not the address has an account.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check your email"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check je e-mail"
          }
        }
      }
    },
    "signIn.codeHelp" : {
      "comment" : "Helper text under the code field on the second step of the sign-in page. The field is described by it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the code from the email."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vul de code uit de e-mail in."
          }
        }
      }
    },
    "signIn.codeLabel" : {
      "comment" : "Label of the field for the 6-digit code from the email (one-time-code autofill on phones). The word alone; the sentence is signIn.codeHelp.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code"
          }
        }
      }
    },
    "signIn.emailLabel" : {
      "comment" : "Label of the email field on the sign-in page.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Email address"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-mailadres"
          }
        }
      }
    },
    "signIn.errors.generic" : {
      "comment" : "Shown when sign-in failed for any other reason.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something went wrong. Try again."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er ging iets mis. Probeer het opnieuw."
          }
        }
      }
    },
    "signIn.errors.invalidEmail" : {
      "comment" : "Under the email field when the address is empty or not an email address.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This email address doesn't look right. Check it and try again."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit e-mailadres klopt niet. Controleer het en probeer het opnieuw."
          }
        }
      }
    },
    "signIn.errors.invalidOrExpiredCode" : {
      "comment" : "Shown when the code was refused. One message for a wrong, expired, used or replaced code: it never says which.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This code isn't right or has expired. Check the code in the email or request a new one."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze code klopt niet of is verlopen. Controleer de code in de e-mail of vraag een nieuwe code aan."
          }
        }
      }
    },
    "signIn.errors.noConnection" : {
      "comment" : "Shown when the sign-in request could not reach the server.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No connection. Check your internet and try again."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen verbinding. Controleer je internet en probeer het opnieuw."
          }
        }
      }
    },
    "signIn.resend" : {
      "comment" : "Button on the second step that sends a new email. The new code replaces the old one.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resend code"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code opnieuw versturen"
          }
        }
      }
    },
    "signIn.resent" : {
      "comment" : "Confirmation after a new email was requested. {email} is the address entered. Does not say whether an account exists.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If %1$@ is registered, you'll receive a new email."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als %1$@ bij ons bekend is, ontvang je een nieuwe e-mail."
          }
        }
      }
    },
    "signIn.sendCode" : {
      "comment" : "Button under the email field of the sign-in page. Sends one email with a 6-digit code and a sign-in link.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send code"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code versturen"
          }
        }
      }
    },
    "signIn.submitCode" : {
      "comment" : "Button that signs in with the code that was entered.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inloggen"
          }
        }
      }
    },
    "signIn.title" : {
      "comment" : "Heading of the first step of the sign-in page (TW-10), where the email address is entered, and the browser tab title of the page.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inloggen"
          }
        }
      }
    }
  },
  "version" : "1.0"
